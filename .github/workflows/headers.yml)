name: Ambil header entity

on:
  workflow_dispatch:

jobs:
  headers:
    runs-on: ubuntu-latest
    steps:
      - name: Ambil source
        run: |
          git clone --depth 1 --recurse-submodules https://github.com/ZacharyLester/CSMoE-Android zl
          git clone --depth 1 https://github.com/3dcakecookiesku-del/CSPB-ANDROID-OPEN-SOURCE cspb

      - name: Salin header
        run: |
          mkdir -p out
          cp zl/app/src/main/jni/src/Xash3D/engine/progdefs.h out/engine_progdefs.h
          cp zl/app/src/main/jni/src/Xash3D/engine/edict.h out/engine_edict.h
          cp cspb/jni/engine/progdefs.h out/server_progdefs.h
          cp cspb/jni/engine/edict.h out/server_edict.h
          ls -la out

      - name: Simpan hasil
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: headers-hasil
          path: out/
